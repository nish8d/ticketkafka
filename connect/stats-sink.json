{
  "name": "stats-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "consumer.override.isolation.level": "read_committed",
    "topics": "tickets.stats",
    "connection.url": "jdbc:postgresql://postgres:5432/tickets",
    "connection.user": "tickets",
    "connection.password": "tickets",
    "table.name.format": "ticket_stats",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "dimension,value,window_start,window_end",
    "auto.create": "false",
    "auto.evolve": "false",
    "max.retries": "60",
    "retry.backoff.ms": "5000",
    "connection.attempts": "24",
    "connection.backoff.ms": "10000",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "tickets.sink.dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false"
  }
}
